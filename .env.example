# Development-only environment example.
#
# Production MUST NOT load all database credentials into one process. Use the
# profile-specific contract in docs/operations/runtime-processes.md and
# deploy/docker-compose.production-identities.yml (or an equivalent orchestrator
# configuration). Production startup rejects forbidden database variables.

ENVIRONMENT=development
LOG_LEVEL=info

# Local development database identities. Auth intentionally uses a distinct
# login because authentication/bootstrap access is a separate database boundary.
DATABASE_URL=postgresql+asyncpg://doers_api:doers_api@localhost:5432/doers
AUTH_DATABASE_URL=postgresql+asyncpg://doers_auth:doers_auth@localhost:5432/doers
# WORKER_DATABASE_URL and MAINTENANCE_DATABASE_URL may be omitted in development;
# their factories fall back to DATABASE_URL outside production.

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

SECRET_KEY=replace-with-a-long-random-development-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

BACKEND_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

MAIL_PROVIDER=resend
MAIL_FROM=noreply@example.local
RESEND_API_KEY=
MAIL_SERVER=sandbox.smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_TEMPLATE_REMINDER=member_renewal_reminder
WA_TEMPLATE_DIGEST=daily_digest_notification
GOOGLE_MAPS_SERVER_API_KEY=

# P4B branch-search provider. Disabled is the safe local/default mode. Production
# ordinary workers must receive the real provider settings through their own
# secret/config bundle; API, auth, maintenance, beat and Flower do not need them.
SEARCH_PROVIDER_MODE=disabled
OPENSEARCH_URL=
OPENSEARCH_INDEX=branches-v1
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_TIMEOUT_SECONDS=5
OPENSEARCH_VERIFY_TLS=true
# Production OpenSearch workers must export low-cardinality provider health,
# latency and drift-repair metrics to an OTLP/HTTP collector. Development may
# leave the endpoint blank while the provider remains disabled.
SEARCH_METRICS_OTLP_ENDPOINT=
SEARCH_METRICS_EXPORT_INTERVAL_SECONDS=30
SEARCH_METRICS_EXPORT_TIMEOUT_SECONDS=5

# Required by the settings schema even when local tests replace storage behavior.
AWS_ACCESS_KEY_ID=local-development
AWS_SECRET_ACCESS_KEY=local-development
AWS_REGION_NAME=us-east-1
S3_BUCKET_NAME=gymflow-local-bucket
CDN_BASE_URL=https://cdn.gymflow.local

# P3B registration envelope encryption. Production must provide a symmetric
# AWS KMS key/alias with GenerateDataKey and Decrypt permissions. The endpoint
# override is for local KMS emulators only and is rejected in production.
AWS_KMS_KEY_ID=
AWS_KMS_ENDPOINT_URL=

# Platform billing features are fail-closed by default.
PLATFORM_BILLING_READ_API=false
PLATFORM_BILLING_SHADOW_RESOLVER=false
PLATFORM_BILLING_ENFORCEMENT=false
PLATFORM_BILLING_FRONTEND_SHELL=false
PLATFORM_BILLING_CHECKOUT=false
PLATFORM_BILLING_FAKE_CHECKOUT_ENABLED=false
PLATFORM_BILLING_FAKE_CHECKOUT_SIMULATION_ENABLED=false
PLATFORM_BILLING_FAKE_CHECKOUT_RECONCILIATION_ENABLED=false
PLATFORM_BILLING_PROVIDER_MODE=disabled
PLATFORM_BILLING_WEBHOOK_PROCESSING=false
PLATFORM_BILLING_DUNNING_TRANSITIONS=false
PLATFORM_BILLING_NOTIFICATIONS=false
