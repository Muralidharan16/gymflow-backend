# Example environment variables for GymFlow backend
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/gymflow
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=replace-with-very-strong-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

RATE_LIMIT_PER_MINUTE=30

# Twilio (WhatsApp)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=rzp_secret_xxx

# Optional bridge default token used for bootstrap (devices will create their own token)
BRIDGE_DEFAULT_TOKEN=bridge-bootstrap-token

LOG_LEVEL=info
