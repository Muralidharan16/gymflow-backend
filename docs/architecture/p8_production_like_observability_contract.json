  },
  "real_runtime_scenarios": {
    "postgresql_authoritative_snapshots": {
      "kind": "real_postgresql_persisted_fault_state",
      "evidence": [
        "tests/test_p4e_operational_snapshots_runtime.py",
        "tests/test_p8_production_like_observability_runtime.py"
      ],
      "proves": [
        "durable dead letters are read from PostgreSQL",
        "Finance reconciliation and provider-ack ambiguity are read through the certified SECURITY DEFINER aggregate snapshot",
        "P8 exports the resulting bounded metrics to a real local OTLP/HTTP receiver"
      ]
    },
    "postgresql_stuck_lifecycle": {
      "kind": "real_postgresql_stuck_transition",
      "evidence": ["tests/test_p8_production_like_observability_runtime.py"],
      "proves": [
        "a persisted transition older than the 15-minute watchdog boundary produces lifecycle stuck evidence",
        "the snapshot is read by the maintenance identity without changing the transition merely to clear telemetry"
      ]
    },
    "redis_queue_age": {
      "kind": "real_redis_delivery_backlog",
      "evidence": ["tests/test_p8_production_like_observability_runtime.py"],
      "proves": [
        "real Redis list depth and Celery publish timestamps produce queue age greater than the five-minute threshold"
      ]
    },
    "sqlalchemy_real_pool_timeout": {
      "kind": "real_postgresql_pool_exhaustion",
      "evidence": ["tests/test_p8_production_like_observability_runtime.py"],
      "proves": [
        "a real async SQLAlchemy QueuePool with no free slot reaches its timeout boundary and records a database pool timeout"
      ]
    },
    "postgresql_service_outage": {
      "kind": "real_postgresql_service_stop_start",
      "evidence": [
        "tests/test_p5d_dependency_loss_runtime.py",
        "tests/test_p8_production_like_observability_runtime.py"
      ],
      "proves": [
        "real database disconnects are visible",
        "durable work remains recoverable after dependency restoration"
      ]
    },
    "redis_service_outage": {
      "kind": "real_redis_container_stop_start",
      "evidence": [
        "tests/test_p5d_dependency_loss_runtime.py",
        "tests/test_p8_production_like_observability_runtime.py"
      ],
      "proves": [
        "broker Redis loss is exported unhealthy",
        "PostgreSQL remains durable business authority during delivery-coordination loss"
      ]
    },
    "p5w2_prefork_death_redelivery": {
      "kind": "real_celery_prefork_process_death",
      "evidence": ["tests/test_p5w2_worker_crash_redelivery_runtime.py"],
      "proves": [
        "real child death before and after DB commit causes broker redelivery",
        "P8 task-prerun redelivery evidence is emitted without changing late-ack or worker-lost semantics",
        "duplicate business effects still converge"
      ]
    },
    "p5d_provider_ack_disconnect": {
      "kind": "real_provider_effect_plus_database_ack_disconnect",
      "evidence": ["tests/test_p5d_dependency_loss_runtime.py"],
      "proves": [
        "provider success followed by DB acknowledgement disconnect does not blindly repeat the external effect",
        "replacement processing converges from durable evidence"
      ]
    },
    "redis_scheduler_contention": {
      "kind": "real_redis_ownership_contention",
      "evidence": ["tests/test_p8_production_like_observability_runtime.py"],
      "proves": [
        "two distinct Beat ownership identities contend on the real Redis lease and the second fails closed"
      ]
    },
    "external_backup_monitor_ingress": {
      "kind": "infrastructure_monitor_signal_ingress",
      "evidence": ["tests/test_p8_production_like_observability_runtime.py"],
      "proves": [
        "stale/failed backup evidence enters only through the explicitly external infrastructure-owned metric boundary",
        "the application does not fabricate backup success"
      ]
    },
    "asgi_failure_and_latency": {
      "kind": "real_asgi_middleware_request",
      "evidence": ["tests/test_p8_production_like_observability_runtime.py"],
      "proves": [
        "an actual request through RequestObservabilityMiddleware produces 5xx and greater-than-one-second latency evidence"
      ]
    },
    "local_provider_timeout": {
      "kind": "real_loopback_http_timeout",
      "evidence": ["tests/test_p8_production_like_observability_runtime.py"],
      "proves": [
        "a real HTTP timeout is classified by the bounded provider metric bridge without tenant/request labels"
      ]
    },
    "otlp_sink_outage_authority_survival": {
      "kind": "real_otlp_connection_failure",
      "evidence": ["tests/test_p8_production_like_observability_runtime.py"],
      "proves": [
        "metrics export loss is observable as missing heartbeat evidence",
        "a durable PostgreSQL commit succeeds while the telemetry sink is unreachable",
        "telemetry delivery never becomes business authority"
      ]
    }
  },
