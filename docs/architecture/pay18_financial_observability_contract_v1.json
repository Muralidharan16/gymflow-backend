  ],
  "hard_stops": [
    "manual financial terminal-state mutation",
    "blind provider retry after ambiguous outcome",
    "delete or rewrite audit/reconciliation/dispute evidence",
    "disable idempotency lease fencing or maker-checker",
    "log payment/customer/provider identifiers or secrets",
    "enable live provider or production credentials",
    "merge release or deployment without later authorization"
  ],
  "safety": {
    "live_provider": "disabled",
    "production_credentials": "disabled",
    "live_money_movement": "disabled",
    "production_runtime_binding": "disabled",
    "merge": "not_authorized",
